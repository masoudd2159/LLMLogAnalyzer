# Frozen official model settings. BglParser rejects incompatible official-run values.
MODEL_NAME=qwen3.5:35b
MODEL_VERSION=AUTO
TEMPERATURE=0
TOP_P=0.9
SEED=42
FORMAT=json
THINKING=false
NUM_CTX=8192
NUM_PREDICT=160

# Services and heavy-model resilience
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONNECT_TIMEOUT=10s
OLLAMA_RESPONSE_TIMEOUT=15m
OLLAMA_MAX_ATTEMPTS=3
OLLAMA_RETRY_INITIAL_BACKOFF=2s
OLLAMA_RETRY_MAX_BACKOFF=15s
KEEP_ALIVE=30m
MONGODB_URI=mongodb://127.0.0.1:27017/LLMLogAnalyzer

# Dataset, persistence, and output
BGL_DATASET_PATH=data/BGL/BGL.log
BGL_TEMPLATE_CACHE=true
BGL_TEMPLATE_GUARD=true
BGL_BATCH_SIZE=1000
CHART_SCOPE=latest-run
CHART_OUTPUT_DIR=results
